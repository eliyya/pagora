# Copy to .env and replace placeholders before running the app.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
APP_URL="http://localhost:3000"
# Discord OAuth application ID (spelling matches the application).
# Enable Public Client in Discord OAuth2 settings; login uses PKCE.
DISCORD_APLICATION_ID="replace-with-discord-application-id"
# Generate 32 random bytes as hex: openssl rand -hex 32
ENCRYPTION_KEY="replace-with-64-hex-characters"
# JWT session signing secret (HS256). Generate with: openssl rand -hex 32
# Use a different value from ENCRYPTION_KEY.
SESSION_SECRET="replace-with-a-random-secret-of-at-least-32-bytes"
# Optional: unique service worker revision for each deployment.
# PWA_BUILD_ID="local-build-1"
