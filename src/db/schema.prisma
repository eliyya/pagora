// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Charge {
  id         String   @id @default(dbgenerated("snowflake()"))
  name       String
  card_id    String
  /// at int like 13.99 => 1399
  amount     Int
  /// at int like 13.99 => 1399
  paid       Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  card         Card         @relation(fields: [card_id], references: [id], onDelete: Cascade)
  payment_logs PaymentLog[]

  @@map("chargues")
}

enum CARD_BRAND {
  mastercard
  visa
  amex
}

model Card {
  id           String     @id @default(dbgenerated("snowflake()"))
  name         String
  owner_id     String
  last4        String
  closing_day  Int
  due_day      Int
  credit_limit Int
  bank         String?
  brand        CARD_BRAND @default(mastercard)

  owner   User     @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  charges Charge[]

  @@unique([owner_id, name])
  @@map("cards")
}

model User {
  id         String   @id @default(dbgenerated("snowflake()"))
  username   String   @unique @map("nickname")
  email      String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  sessions     Session[]
  accounts     Account[]
  cards        Card[]
  agent_tokens AgentToken[]
  shareQuotas share_quota[]

  @@map("users")
}

enum PROVIDERS {
  discord
}

model Account {
  id                   String    @id @default(dbgenerated("snowflake()"))
  user_id              String
  provider_acccount_id String
  email                String
  provider             PROVIDERS
  refresh_token        String?
  access_token         String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_acccount_id])
  @@map("accounts")
}

model Session {
  id            String   @id @default(dbgenerated("snowflake()"))
  user_id       String
  /// Hashed
  refresh_token String   @unique
  expires_at    DateTime
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

enum PaymentStatus {
  success
  failed
  pending
  refunded
}

model PaymentLog {
  id         String        @id @default(dbgenerated("snowflake()"))
  charge_id  String
  amount     Int
  status     PaymentStatus
  created_at DateTime      @default(now())

  charge Charge @relation(fields: [charge_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([charge_id])
  @@index([created_at])
}

model AgentToken {
  id           String    @id @default(dbgenerated("snowflake()"))
  user_id      String
  name         String
  token_hash   String    @unique
  scopes       String[]
  last_used_at DateTime?
  expires_at   DateTime?
  revoked_at   DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([revoked_at])
  @@map("agent_tokens")
}

model Plan {
  id         String   @id @default(dbgenerated("snowflake()"))
  name       String
  price      Int      /// at int like 13.99 => 1399
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model share_quota {
  id         String   @id @default(dbgenerated("snowflake()"))
  user_id    String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}
