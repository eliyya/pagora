// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ChargeKind {
  single
  installment_parent
  installment
}

enum SubscriptionStatus {
  active
  paused
  canceled
}

/// Monthly recurrence rule. Charges are created only when their occurrence is due.
model Subscription {
  id          String             @id @default(dbgenerated("snowflake()"))
  name        String
  card_id     String
  category_id String?
  /// Amount per occurrence in cents; copied into each generated charge.
  amount      Int
  status      SubscriptionStatus @default(active)
  /// Original monthly anchor. Constrain its day in short months without changing the anchor.
  starts_on   DateTime           @db.Date
  /// Next unprocessed occurrence, retained while paused or canceled.
  next_due_on DateTime           @db.Date
  /// IANA time zone used to determine whether a calendar date is due.
  time_zone   String             @default("America/Mexico_City")
  revision    Int                @default(0)
  created_at  DateTime           @default(now())
  updated_at  DateTime           @updatedAt

  card     Card            @relation(fields: [card_id], references: [id], onDelete: Cascade)
  category ChargeCategory? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  charges  Charge[]

  @@unique([id, card_id])
  @@index([card_id, status])
  @@index([status, next_due_on])
  @@index([category_id])
  @@map("subscriptions")
}

model Charge {
  id                    String     @id @default(dbgenerated("snowflake()"))
  name                  String
  card_id               String
  category_id           String?
  kind                  ChargeKind @default(single)
  installment_parent_id String?
  installment_number    Int?
  installment_count     Int?
  /// Generated subscription charges use kind = single.
  subscription_id       String?
  /// Original occurrence identity; do not change when editing scheduled_for.
  subscription_due_on   DateTime?  @db.Date
  /// at int like 13.99 => 1399
  amount                Int
  /// at int like 13.99 => 1399
  paid                  Int        @default(0)
  revision              Int        @default(0)
  scheduled_for         DateTime   @default(now()) @db.Date
  created_at            DateTime   @default(now())
  updated_at            DateTime   @updatedAt

  card               Card            @relation(fields: [card_id], references: [id], onDelete: Cascade)
  category           ChargeCategory? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  installment_parent Charge?         @relation("ChargeInstallments", fields: [installment_parent_id, card_id], references: [id, card_id], onDelete: Cascade)
  installments       Charge[]        @relation("ChargeInstallments")
  payment_logs       PaymentLog[]
  subscription       Subscription?   @relation(fields: [subscription_id, card_id], references: [id, card_id], onDelete: NoAction)

  @@unique([id, card_id])
  @@unique([installment_parent_id, installment_number])
  @@unique([subscription_id, subscription_due_on])
  @@index([category_id])
  @@index([installment_parent_id])
  @@index([card_id, kind, scheduled_for])
  @@map("chargues")
}

model ChargeCategory {
  id             String   @id @default(dbgenerated("snowflake()"))
  card_id        String
  name           String
  /// at int like 13.99 => 1399. Zero means no budget is set.
  monthly_budget Int      @default(0)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  card          Card           @relation(fields: [card_id], references: [id], onDelete: Cascade)
  charges       Charge[]
  subscriptions Subscription[]

  @@unique([card_id, name])
  @@index([card_id])
  @@map("charge_categories")
}

enum CARD_BRAND {
  mastercard
  visa
  amex
}

model Card {
  id           String     @id @default(dbgenerated("snowflake()"))
  name         String
  owner_id     String
  last4        String
  closing_day  Int
  due_day      Int
  credit_limit Int
  bank         String?
  brand        CARD_BRAND @default(mastercard)
  updated_at   DateTime   @default(now()) @updatedAt
  sync_version Int        @default(0)

  owner         User              @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  charges       Charge[]
  categories    ChargeCategory[]
  changes       CardChange[]
  mutations     AppliedMutation[]
  members       CardMember[]
  invitations   CardInvitation[]
  subscriptions Subscription[]

  @@unique([owner_id, name])
  @@map("cards")
}

model CardChange {
  id         BigInt   @id @default(autoincrement())
  card_id    String
  version    Int
  entity     String
  entity_id  String
  operation  String
  created_at DateTime @default(now())

  card Card @relation(fields: [card_id], references: [id], onDelete: Cascade)

  @@index([card_id, version])
  @@map("card_changes")
}

model AppliedMutation {
  mutation_id  String
  card_id      String
  user_id      String
  request_hash String
  result       Json
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  card Card @relation(fields: [card_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([card_id, mutation_id])
  @@index([user_id])
  @@map("applied_mutations")
}

enum CardPermission {
  read
  write
}

enum CardInvitationStatus {
  pending
  accepted
  declined
  canceled
}

model CardMember {
  id         String         @id @default(dbgenerated("snowflake()"))
  card_id    String
  user_id    String
  permission CardPermission @default(read)
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt

  card Card @relation(fields: [card_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([card_id, user_id])
  @@index([user_id])
  @@map("card_members")
}

model CardInvitation {
  id           String               @id @default(dbgenerated("snowflake()"))
  card_id      String
  inviter_id   String
  invitee_id   String
  permission   CardPermission       @default(read)
  status       CardInvitationStatus @default(pending)
  responded_at DateTime?
  created_at   DateTime             @default(now())
  updated_at   DateTime             @updatedAt

  card    Card @relation(fields: [card_id], references: [id], onDelete: Cascade)
  inviter User @relation("CardInvitationInviter", fields: [inviter_id], references: [id], onDelete: Cascade)
  invitee User @relation("CardInvitationInvitee", fields: [invitee_id], references: [id], onDelete: Cascade)

  @@index([card_id])
  @@index([invitee_id, status])
  @@index([inviter_id])
  @@map("card_invitations")
}

model User {
  id         String   @id @default(dbgenerated("snowflake()"))
  username   String   @unique @map("nickname")
  email      String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  sessions                Session[]
  accounts                Account[]
  cards                   Card[]
  cardMembers             CardMember[]
  sentCardInvitations     CardInvitation[]  @relation("CardInvitationInviter")
  receivedCardInvitations CardInvitation[]  @relation("CardInvitationInvitee")
  appliedMutations        AppliedMutation[]
  agent_tokens            AgentToken[]
  shareQuotas             share_quota[]

  @@map("users")
}

enum PROVIDERS {
  discord
}

model Account {
  id                   String    @id @default(dbgenerated("snowflake()"))
  user_id              String
  provider_acccount_id String
  email                String
  provider             PROVIDERS
  refresh_token        String?
  access_token         String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_acccount_id])
  @@map("accounts")
}

model Session {
  id            String   @id @default(dbgenerated("snowflake()"))
  user_id       String
  /// Hashed
  refresh_token String   @unique
  expires_at    DateTime
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

enum PaymentStatus {
  success
  failed
  pending
  refunded
}

model PaymentLog {
  id         String        @id @default(dbgenerated("snowflake()"))
  charge_id  String
  amount     Int
  status     PaymentStatus
  created_at DateTime      @default(now())

  charge Charge @relation(fields: [charge_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([charge_id])
  @@index([created_at])
}

model AgentToken {
  id           String    @id @default(dbgenerated("snowflake()"))
  user_id      String
  name         String
  token_hash   String    @unique
  scopes       String[]
  last_used_at DateTime?
  expires_at   DateTime?
  revoked_at   DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([revoked_at])
  @@map("agent_tokens")
}

model Plan {
  id         String   @id @default(dbgenerated("snowflake()"))
  name       String
  price      Int /// at int like 13.99 => 1399
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model share_quota {
  id         String   @id @default(dbgenerated("snowflake()"))
  user_id    String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}
