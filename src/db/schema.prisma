// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Charge {
  id         String   @id @default(dbgenerated("snowflake()"))
  name       String
  card_id    String
  category_id String?
  /// at int like 13.99 => 1399
  amount     Int
  /// at int like 13.99 => 1399
  paid       Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  card         Card         @relation(fields: [card_id], references: [id], onDelete: Cascade)
  category     ChargeCategory? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  payment_logs PaymentLog[]

  @@index([category_id])
  @@map("chargues")
}

model ChargeCategory {
  id             String   @id @default(dbgenerated("snowflake()"))
  card_id        String
  name           String
  /// at int like 13.99 => 1399. Zero means no budget is set.
  monthly_budget Int      @default(0)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  card    Card     @relation(fields: [card_id], references: [id], onDelete: Cascade)
  charges Charge[]

  @@unique([card_id, name])
  @@index([card_id])
  @@map("charge_categories")
}

enum CARD_BRAND {
  mastercard
  visa
  amex
}

model Card {
  id           String     @id @default(dbgenerated("snowflake()"))
  name         String
  owner_id     String
  last4        String
  closing_day  Int
  due_day      Int
  credit_limit Int
  bank         String?
  brand        CARD_BRAND @default(mastercard)
  updated_at   DateTime   @default(now()) @updatedAt

  owner   User     @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  charges Charge[]
  categories ChargeCategory[]
  members CardMember[]
  invitations CardInvitation[]

  @@unique([owner_id, name])
  @@map("cards")
}

enum CardPermission {
  read
  write
}

enum CardInvitationStatus {
  pending
  accepted
  declined
  canceled
}

model CardMember {
  id         String         @id @default(dbgenerated("snowflake()"))
  card_id    String
  user_id    String
  permission CardPermission @default(read)
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt

  card Card @relation(fields: [card_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([card_id, user_id])
  @@index([user_id])
  @@map("card_members")
}

model CardInvitation {
  id           String               @id @default(dbgenerated("snowflake()"))
  card_id      String
  inviter_id   String
  invitee_id   String
  permission   CardPermission       @default(read)
  status       CardInvitationStatus @default(pending)
  responded_at DateTime?
  created_at   DateTime             @default(now())
  updated_at   DateTime             @updatedAt

  card    Card @relation(fields: [card_id], references: [id], onDelete: Cascade)
  inviter User @relation("CardInvitationInviter", fields: [inviter_id], references: [id], onDelete: Cascade)
  invitee User @relation("CardInvitationInvitee", fields: [invitee_id], references: [id], onDelete: Cascade)

  @@index([card_id])
  @@index([invitee_id, status])
  @@index([inviter_id])
  @@map("card_invitations")
}

model User {
  id         String   @id @default(dbgenerated("snowflake()"))
  username   String   @unique @map("nickname")
  email      String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  sessions     Session[]
  accounts     Account[]
  cards        Card[]
  cardMembers  CardMember[]
  sentCardInvitations CardInvitation[] @relation("CardInvitationInviter")
  receivedCardInvitations CardInvitation[] @relation("CardInvitationInvitee")
  agent_tokens AgentToken[]
  shareQuotas share_quota[]

  @@map("users")
}

enum PROVIDERS {
  discord
}

model Account {
  id                   String    @id @default(dbgenerated("snowflake()"))
  user_id              String
  provider_acccount_id String
  email                String
  provider             PROVIDERS
  refresh_token        String?
  access_token         String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_acccount_id])
  @@map("accounts")
}

model Session {
  id            String   @id @default(dbgenerated("snowflake()"))
  user_id       String
  /// Hashed
  refresh_token String   @unique
  expires_at    DateTime
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

enum PaymentStatus {
  success
  failed
  pending
  refunded
}

model PaymentLog {
  id         String        @id @default(dbgenerated("snowflake()"))
  charge_id  String
  amount     Int
  status     PaymentStatus
  created_at DateTime      @default(now())

  charge Charge @relation(fields: [charge_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([charge_id])
  @@index([created_at])
}

model AgentToken {
  id           String    @id @default(dbgenerated("snowflake()"))
  user_id      String
  name         String
  token_hash   String    @unique
  scopes       String[]
  last_used_at DateTime?
  expires_at   DateTime?
  revoked_at   DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([revoked_at])
  @@map("agent_tokens")
}

model Plan {
  id         String   @id @default(dbgenerated("snowflake()"))
  name       String
  price      Int      /// at int like 13.99 => 1399
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model share_quota {
  id         String   @id @default(dbgenerated("snowflake()"))
  user_id    String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}
